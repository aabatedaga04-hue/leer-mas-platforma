# Copiar a .env.local y completar con los valores reales del proyecto.
# Vite solo expone al navegador las variables con prefijo VITE_.

# Supabase -> Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Books API -> https://console.cloud.google.com (habilitar "Books API")
# En la práctica hace falta: las consultas anónimas se atribuyen a un proyecto
# compartido que suele tener cuota 0 y devuelven 429 de entrada.
VITE_GOOGLE_BOOKS_API_KEY=
